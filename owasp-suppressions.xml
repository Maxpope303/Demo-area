    <!-- Suppress WebSphere provided dependencies -->
    <suppress>
        <notes><![CDATA[
        WebSphere provided dependencies are managed by the application server
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.ibm\.websphere\.appserver/.*$</packageUrl>
    </suppress>
    
    <!-- Suppress servlet API as it's provided by container -->
    <suppress>
        <notes><![CDATA[
        Servlet API is provided by the application server
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/javax\.servlet/.*$</packageUrl>
    </suppress>

</suppressions>

